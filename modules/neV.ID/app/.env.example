# Clé publique Clerk (peut être intégrée au bundle frontend).
VITE_CLERK_PUBLISHABLE_KEY=

# Secrets privés : uniquement côté serveur. Ne jamais les préfixer par VITE_.
CLERK_SECRET_KEY=

# Origines exactes autorisées à initier une requête authentifiée vers ce backend.
# En production, remplacer par l'origine réelle du portail de compte neV.ID.
NEV_ID_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173
